---
layout: null
permalink: /podcast/feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
  xmlns:atom="http://www.w3.org/2005/Atom"
  xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
  xmlns:podcast="https://podcastindex.org/namespace/1.0"
  xmlns:content="http://purl.org/rss/1.0/modules/content/">
  {% assign base = site.url | append: site.baseurl %}
  {% assign episodes = site.podcast | concat: site.posts | sort: "date" | reverse %}

  <channel>
    <title>{{ site.title | xml_escape }} Podcast</title>
    <link>{{ base | xml_escape }}/podcast/</link>
    <description>{{ site.description | xml_escape }}</description>
    <language>{{ site.lang | default: 'es' }}</language>
    <atom:link href="{{ base | xml_escape }}/podcast/feed.xml" rel="self" type="application/rss+xml" />

    <itunes:author>{{ site.podcast.author | default: site.title | xml_escape }}</itunes:author>
    <itunes:summary>{{ site.description | xml_escape }}</itunes:summary>
    <itunes:explicit>{% if site.podcast.explicit == true %}true{% else %}false{% endif %}</itunes:explicit>
    <podcast:locked>no</podcast:locked>

    {% if site.podcast.owner_name or site.podcast.owner_email %}
    <itunes:owner>
      {% if site.podcast.owner_name %}<itunes:name>{{ site.podcast.owner_name | xml_escape }}</itunes:name>{% endif %}
      {% if site.podcast.owner_email %}<itunes:email>{{ site.podcast.owner_email | xml_escape }}</itunes:email>{% endif %}
    </itunes:owner>
    {% endif %}

    {% if site.podcast.image %}
      <itunes:image href="{% if site.podcast.image contains '://' %}{{ site.podcast.image | xml_escape }}{% else %}{{ base | xml_escape }}{{ site.podcast.image | xml_escape }}{% endif %}" />
    {% endif %}

    {% if site.podcast.category %}
      {% if site.podcast.subcategory %}
        <itunes:category text="{{ site.podcast.category | xml_escape }}">
          <itunes:category text="{{ site.podcast.subcategory | xml_escape }}" />
        </itunes:category>
      {% else %}
        <itunes:category text="{{ site.podcast.category | xml_escape }}" />
      {% endif %}
    {% endif %}

    {% for post in episodes %}
      {% if post.collection == "posts" %}
        {% assign inferred_audio_rel = post.path | remove_first: "_posts/" | replace: ".markdown", ".mp3" | replace: ".md", ".mp3" %}
      {% else %}
        {% assign inferred_audio_rel = post.path | remove_first: "_podcast/" | replace: ".markdown", ".mp3" | replace: ".md", ".mp3" %}
      {% endif %}
      {% assign inferred_audio_path = "/audio/" | append: inferred_audio_rel %}
      {% assign has_inferred_audio = false %}
      {% for static_file in site.static_files %}
        {% if static_file.path == inferred_audio_path %}
          {% assign has_inferred_audio = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% assign audio_abs = "" %}
      {% assign audio_type = post.audio_type | default: "audio/mpeg" %}
      {% if post.audio_url %}
        {% assign audio_abs = post.audio_url %}
        {% if audio_abs contains '://' %}
        {% else %}
          {% assign audio_abs = base | append: post.audio_url %}
        {% endif %}
      {% elsif has_inferred_audio %}
        {% assign audio_abs = base | append: inferred_audio_path %}
      {% endif %}

      {% if audio_abs != "" %}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        {% assign post_link = base | append: post.url %}
        <link>{{ post_link | xml_escape }}</link>
        <guid isPermaLink="true">{{ post_link | xml_escape }}</guid>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <description>{{ post.description | default: post.excerpt | strip_html | strip_newlines | xml_escape }}</description>

        <enclosure url="{{ audio_abs | replace: ' ', '%20' | xml_escape }}" length="{{ post.audio_length | default: 0 }}" type="{{ audio_type }}" />

        <itunes:summary>{{ post.description | default: post.excerpt | strip_html | strip_newlines | xml_escape }}</itunes:summary>
        {% if post.duration %}<itunes:duration>{{ post.duration }}</itunes:duration>{% endif %}
        {% if post.episode %}<itunes:episode>{{ post.episode }}</itunes:episode>{% endif %}
        {% if post.season %}<itunes:season>{{ post.season }}</itunes:season>{% endif %}
        {% if post.explicit != nil %}<itunes:explicit>{% if post.explicit == true %}true{% else %}false{% endif %}</itunes:explicit>{% endif %}
      </item>
      {% endif %}
    {% endfor %}
  </channel>
</rss>
